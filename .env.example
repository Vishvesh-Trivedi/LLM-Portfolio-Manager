# Copy to .env and fill in. NEVER commit the real .env (.gitignore covers it).
# In GitHub Actions these are repository Secrets, not a file.

# ── Required: LLM reasoning ────────────────────────────────────────────────
# Free key from build.nvidia.com -> sign up -> "Get API Key"
NVIDIA_API_KEY=

# Optional backup provider, used only when every NVIDIA model fails.
OPENROUTER_API_KEY=

# ── Optional: Alpaca market data + paper execution ─────────────────────────
# With only the two keys set, Alpaca becomes the PRIMARY market-data source
# (Yahoo is throttled from datacenter IPs). No orders are placed.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex          # 'iex' free (default) or 'sip' paid
ALPACA_PAPER=1                # 1 = paper endpoint (default), 0 = LIVE money

# Set to 1 to mirror the ledger onto the Alpaca account AND make Alpaca the
# source of truth for fills, share counts and cash. Leave unset for a purely
# local paper ledger.
SCREENER_LIVE_BROKER=

# ── Optional: Discord alerts (primary channel) ─────────────────────────────
# Create an application at discord.com/developers, add a Bot, invite it to the
# server with "Send Messages", then copy the bot token and the channel id
# (enable Developer Mode -> right-click channel -> Copy Channel ID).
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# ── Optional: WhatsApp alerts (via CallMeBot) ──────────────────────────────
WHATSAPP_PHONE=
CALLMEBOT_API_KEY=

# Check everything above is wired correctly before trading:
#   python qa_validate.py --preflight

# ── Operational switches ───────────────────────────────────────────────────
SCREENER_OUTPUT_DIR=          # override the StockScreener/ output folder
SCREENER_DISABLE_ALERTS=      # 1 silences Discord and WhatsApp
SCREENER_ALERT_TEST=          # 1 marks every alert as a TEST (messages only,
                              #   does NOT stop orders - use SCREENER_LIVE_BROKER)
SCREENER_FORCE_SESSION=       # 1 allows a rerun of an already-processed session
SCREENER_ENABLE_SELF_TUNING=  # 1 lets the LLM write config proposals (off by default)
SCREENER_DEBUG=               # 1 logs why tickers fail compute_indicators
